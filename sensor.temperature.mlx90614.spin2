#include "sensor.temp.common.spin2h"            ' use code common to all temperature sensor drivers

CON

    { default I/O settings; these can be overridden in the parent object }
    SCL         = 0
    SDA         = 1
    I2C_FREQ    = 100_000
    I2C_ADDR    = $5a                           ' factory-default slave address

    SLAVE_WR    = core.SLAVE_ADDR
    SLAVE_RD    = core.SLAVE_ADDR | 1


OBJ

    i2c:    "com.i2c"                           ' I2C engine
    core:   "core.con.mlx90614"                 ' HW-specific constants
    crc:    "math.crc"                          ' CRC routines


VAR

    byte _slave_addr
    byte _temp_ch                               ' temp. sensor channel #


PUB null()
' This is not a top-level object


PUB start(): status
' Start using default I/O settings
    return startx(SCL, SDA, I2C_FREQ, I2C_ADDR)


PUB startx(SCL_PIN, SDA_PIN, I2C_HZ, ADDR_BITS): status
' Start the driver with custom I/O settings
'   SCL_PIN:    I2C clock, 0..63
'   SDA_PIN:    I2C data, 0..63
'   I2C_HZ:     I2C clock speed (max official specification is 400_000 but is unenforced)
'   ADDR_BITS:  sensor slave address (addresses from $01..$7f)
'   Returns:
'       cog ID+1 of I2C engine on success
'       0 on failure
    if ( lookdown(SCL_PIN: 0..63) and lookdown(SDA_PIN: 0..63) )
        if ( status := i2c.init(SCL_PIN, SDA_PIN, I2C_HZ) )
            waitus(core.T_POR)
            _slave_addr := (ADDR_BITS << 1)
            if ( dev_id() >= 0 )
                return
    ' if this point is reached, something above failed
    ' Double check I/O pin assignments, connections, power
    ' Lastly - make sure you have at least one free core/cog
    return FALSE


PUB stop()
' Stop the driver
    i2c.deinit()
    _temp_ch := 0


PUB amb_temp_data(): a
' Read ambient temperature ADC data
'   Returns: s16
    return readreg(core.T_A)


PUB amb_temp(): t
' Reads the Ambient temperature
'   Returns: Temperature in hundredths of a degree (e.g., 2135 is 21.35 deg),
'       using the chosen scale
    return temp_word2deg( amb_temp_data() )


PUB dev_id(): id
' Reads the sensor ID
    id := readreg(core.EE_MLX_SLAVEADDR)
    if ( id < 0 )
        return                                  ' error

    ' the high byte at this EE address might contain garbage so discard it; we only want the
    '   lower byte
    return (id & $ff)


PUB fir_filter_samples(s=-2): c
' Set the number of samples used by the on-chip FIR filter
'   s:  8, 16, 32, 64, 128, 256, 512, 1024
'   NOTE: Values below 128 are not recommended
    c := readreg(core.EE_CFG)
    case s
        8, 16, 32, 64, 128, 256, 512, 1024:
            s := lookdownz(s: 8, 16, 32, 64, 128, 256, 512, 1024)
            s := (c & core.FIR_MASK) | (s << core.FIR)
            write_eeprom(core.EE_CFG, s)
        other:
            c := ((c >> core.FIR) & core.FIR_BITS)
            return lookupz(c: 8, 16, 32, 64, 128, 256, 512, 1024)


PUB gain(g=-2): c
' Set the sensor gain
'   g:  1, 3, 6, 12, 25, 5, 100
    c := readreg(core.EE_CFG)
    case g
        1, 3, 6, 12, 25, 5, 100:
            g := lookdownz(g: 1, 3, 6, 12, 25, 5, 100) << core.GAIN
            g := (c & core.GAIN_MASK) | g
            write_eeprom(core.EE_CFG, g)
        other:
            c := ((c >> core.GAIN) & core.GAIN_BITS)
            return lookupz(c: 1, 3, 6, 12, 25, 5, 100, 100)


PUB iir_filter_strength(s=-2): c
' Set strength of the on-chip IIR filter
'   (limit spikes/pulses of temperature changes to a percentage of the sensed temperature)
'   s:  13, 17, 25, 50, 57, 67, 80, 100 (percent)
'   NOTE: Values below 128 are not recommended
    c := readreg(core.EE_CFG)
    case s
        13, 17, 25, 50, 57, 67, 80, 100:
            s := (c & core.IIR_MASK) | lookdownz(s: 50, 25, 17, 13, 100, 80, 67, 57)
            write_eeprom(core.EE_CFG, s)
        other:
            return lookupz( (c & core.IIR_BITS): 50, 25, 17, 13, 100, 80, 67, 57)


PUB rd_eeprom(p_buff): s | r, word tmp[32]
' Dump EEPROM to array at p_buff
'   NOTE: p_buff must be at least 32 words
    s := 0
    wordfill(@tmp, 0, 32)
    repeat r from $20 to $3f
        s := readreg(r)
        if ( s < 0 )
            return                              ' error
        tmp[r-$20] := s

    wordmove(p_buff, @tmp, 32)


PUB serial_num(p_sn): s | n, tmp[2]
' Read serial number from sensor
'   p_sn:   pointer to buffer to copy serial number to (must be at least 4 words in size)
    s := 0
    repeat n from 0 to 3
        s := readreg(core.EE_ID_1+n)
        if ( s < 0 )
            return                              ' error
        tmp.word[n] := s

    wordmove(p_sn, @tmp, 4)


PUB set_slave_address(a): s | t
' Set the sensor's slave address
'   a:  new address ($01..$7f)
'   NOTE: The sensor's power must be cycled for the new address to take effect.
'       Until that time, the sensor will continue to respond on the prior address.
    if ( (a < $01) or (a > $7f) )               ' only allow valid addresses
        return -1

    ' read the current address; we only really care about the LSB, but the MSB in EEPROM may have
    '   some non-zero value in it. It isn't documented specifically, but preserve it in case it's
    '   important in some way. Then write it, combined with the new address.
    t := readreg(core.EE_MLX_SLAVEADDR) & $ff00
    s := write_eeprom(core.EE_MLX_SLAVEADDR, (a & $ff) | t)
    if ( s < 0 )
        return                                  ' error
    _slave_addr := (a << 1)                     ' set the new address in hub RAM


PUB set_temp_channel(ch)
' Set temperature sensor channel #
'   Valid values: 1, 2 (CH2 availability is device-dependent)
    _temp_ch := ((1 #> ch <# 2) - 1)


PUB temp_channel(): curr_ch
' Get temperature sensor currently set channel #
    return (_temp_ch + 1)


PUB temp_data(): w
' Read object temperature ADC word
'   Returns: s16
    w := readreg(core.T_OBJ1 + _temp_ch)
    if ( w < 0 )
        return                                  ' error

    return (w & $ffff)


PUB temp_word2deg(w): d
' Convert temperature ADC word to temperature
'   Returns: temperature, in hundredths of a degree, in chosen scale
    w *= 2
    case _temp_scale
        C:
            return w - 273_15
        F:
            return (((w - 273_15) * 9_00) / 5_00) + 32_00
        K:
            return
        other:
            return FALSE


PRI readreg(reg_nr): v | cmd_pkt, rd, tmp[2], ack
' Read word(s) from device into p_buff
    cmd_pkt.byte[0] := _slave_addr
    cmd_pkt.byte[1] := reg_nr

    v := 0
    rd := 0
    i2c.start()
    ack := i2c.wrblock_lsbf(@cmd_pkt, 2)
    if ( ack <> i2c.ACK )
        i2c.stop()                              ' no response from sensor
        return -1
    i2c.start()
    ack := i2c.write(_slave_addr|1)
    if ( ack <> i2c.ACK )
        i2c.stop()                              ' no response from sensor
        return -1
    i2c.rdblock_lsbf(@rd, 3, i2c.NAK)           ' read word plus the PEC
    i2c.stop()

    ' the CRC from the sensor incorporates the command sent as well the data it sent back
    tmp.byte[0] := cmd_pkt.byte[0]
    tmp.byte[1] := cmd_pkt.byte[1]
    tmp.byte[2] := _slave_addr|1
    tmp.byte[3] := rd.byte[0]
    tmp.byte[4] := rd.byte[1]

    ' compare it to our own check and if it matches, return the data
    if ( crc.crc8(  @tmp, 5, ...
                    $00, $00, ...               ' initial value = $00, xor final CRC with $00
                    crc.POLY8_MELEXIS, ...
                    0, 0 ) == rd.byte[2])       ' input, output reflect = false
        return rd.word[0]
    else
        return -2                               ' error: bad CRC


PRI write_eeprom(reg_nr, val): s | cmd_pkt[2], ack
' Write value to sensor EEPROM
'   reg_nr: sensor EEPROM register/address
'   val:    value to write
    s := 0
    cmd_pkt.byte[0] := _slave_addr
    cmd_pkt.byte[1] := reg_nr
    cmd_pkt.byte[2] := 0
    cmd_pkt.byte[3] := 0
    cmd_pkt.byte[4] := crc.crc8(@cmd_pkt, 4, ...' check the previous four bytes
                                $00, $00, ...
                                crc.POLY8_MELEXIS, ...
                                0, 0)

    ' erase the cell
    i2c.start()
    ack := i2c.wrblock_lsbf(@cmd_pkt, 5)
    if ( ack <> i2c.ACK )
        i2c.stop()                              ' no response from sensor
        return -1
    i2c.stop()
    waitus(core.T_ERASE_MAX)                    ' wait for the EE to finish


    cmd_pkt.byte[2] := val.byte[0]              ' update the cmd packet with the new value
    cmd_pkt.byte[3] := val.byte[1]              '   and CRC
    cmd_pkt.byte[4] := crc.crc8(@cmd_pkt, 4, ...
                                $00, $00, ...
                                crc.POLY8_MELEXIS, ...
                                0, 0)

    ' now write the new value
    i2c.start()
    ack := i2c.wrblock_lsbf(@cmd_pkt, 5)
    if ( ack <> i2c.ACK )
        i2c.stop()                              ' no response from sensor
        return -1
    i2c.stop()
    waitus(core.T_WRITE_MAX)


DAT
